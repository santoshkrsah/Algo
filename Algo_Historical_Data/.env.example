# Copy this file to .env and fill in your own values. NEVER commit .env (it is git-ignored).

# Fyers API app (create one at https://myapi.fyers.in)
# The number after the dash in the app id is the app type (e.g. -100); keep it exactly as Fyers shows it.
FYERS_APP_ID=XXXXXXXXXX-100
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html
FYERS_USERNAME=
FYERS_PIN=
FYERS_TOTP_KEY=

# Telegram notifications (optional): create a bot with @BotFather, add it to your group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=
