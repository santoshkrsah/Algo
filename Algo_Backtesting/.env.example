# Copy to .env and fill in. NEVER commit .env.
# Telegram notifications: create a bot with @BotFather, add it to your group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# Optional: where the downloaded data lives (default: ../Algo_Historical_Data/data)
# HISTORICAL_DATA_DIR=

# Telegram bot that answers questions (tools/telegram_bot.py): who may use it.
# Numeric Telegram ids and/or @usernames, comma separated. TELEGRAM_CHAT_ID (your personal chat) is always allowed.
TELEGRAM_ALLOWED_USERS=
# Optional: BOT_PERMISSION_MODE=auto (full control, Claude's safety check; default) or plan (only read + answer)
# BOT_PERMISSION_MODE=auto
# BOT_MODEL=
# BOT_EFFORT=
# BOT_MAX_JOBS=2
# BOT_JOB_HOURS=4
# CLAUDE_BIN=   (path to claude.exe; found automatically if empty)
