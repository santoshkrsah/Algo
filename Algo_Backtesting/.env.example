# Copy to .env and fill in. NEVER commit .env.
# Telegram notifications: create a bot with @BotFather, add it to your group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# Optional: where the downloaded data lives (default: ../Algo_Historical_Data/data)
# HISTORICAL_DATA_DIR=

# Reports website on your own server (upload with tools/upload_site.py). Fill in; NEVER commit .env.
# SITE_PROTOCOL: sftp (best), ftps, or ftp (plain, password not encrypted - avoid)
SITE_PROTOCOL=sftp
SITE_FTP_HOST=
SITE_FTP_PORT=
SITE_FTP_USER=
SITE_FTP_PASS=
# Folder on the server that the website serves, e.g. /public_html/algo-reports  (the FTP user should only reach this folder)
SITE_FTP_DIR=
# Public address of that folder in the browser, no trailing slash, e.g. https://example.com/algo-reports
SITE_URL=
# Only if the site is password protected (.htaccess / basic auth) - used for the upload check, not stored in the site
SITE_WEB_USER=
SITE_WEB_PASS=
